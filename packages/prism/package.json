{
  "name": "@pydemia/prism",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild src/index.ts --bundle --platform=neutral --format=esm --packages=external --jsx=automatic --outfile=dist/index.js",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@pydemia/ui": "*",
    "@radix-ui/react-tooltip": "1.2.16",
    "date-fns": "^4.1.0",
    "fflate": "0.8.3",
    "jspdf": "4.2.1",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.3.289",
    "postcss-value-parser": "4.2.0",
    "pretendard": "1.3.9",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "jsdom": "26.1.0",
    "typescript": "^5.9.3"
  }
}
