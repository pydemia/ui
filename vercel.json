{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "docs",
  "rewrites": [
    {
      "source": "/prism",
      "destination": "/prism/index.html"
    },
    {
      "source": "/prism/",
      "destination": "/prism/index.html"
    }
  ]
}
